{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloneForge",
  "version": "0.1.0",
  "identifier": "com.cloneforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloneForge — Clonagem e Deploy de SO",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Clonagem, backup e deploy de sistemas operacionais",
    "longDescription": "CloneForge: motor multiplataforma de clonagem de disco (raw/smart copy), imagens ISO/WIM/IMG, verificação BLAKE3 e auditoria local.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["PortugueseBr", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] },
      "appimage": {}
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
