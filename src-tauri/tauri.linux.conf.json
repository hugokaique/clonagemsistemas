{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "cargo build --release -p cloneforge-helper --manifest-path src-tauri/Cargo.toml || cargo build --release -p cloneforge-helper"
  },
  "bundle": {
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1"
        ],
        "recommends": [
          "partclone"
        ],
        "files": {
          "/usr/bin/cloneforge-helper": "target/release/cloneforge-helper",
          "/usr/share/polkit-1/actions/com.cloneforge.helper.policy": "assets/com.cloneforge.helper.policy"
        }
      },
      "rpm": {
        "depends": [
          "polkit"
        ],
        "recommends": [
          "partclone"
        ],
        "files": {
          "/usr/bin/cloneforge-helper": "target/release/cloneforge-helper",
          "/usr/share/polkit-1/actions/com.cloneforge.helper.policy": "assets/com.cloneforge.helper.policy"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/cloneforge-helper": "target/release/cloneforge-helper"
        }
      }
    }
  }
}
